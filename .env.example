# Sao chép thành .env (cùng thư mục với scrapy.cfg). Trên Crawlab, khai báo các biến này
# trong phần Environment của spider. KHÔNG commit file .env và file SSL.

# ===================== Kafka =====================
# true = dùng Kafka local (docker compose --profile kafka up -d): tự đặt KAFKA_MODE=broker,
# bootstrap localhost:KAFKA_LOCAL_PORT, không SSL. Bỏ qua KAFKA_MODE / KAFKA_BOOTSTRAP_SERVERS / SSL bên dưới.
# false = dùng Kafka dev/Hydra theo các biến bên dưới
KAFKA_LOCAL=false
# Cổng Kafka local trên máy (docker compose cũng đọc biến này)
KAFKA_LOCAL_PORT=9092
# Cổng giao diện Kafka UI: http://localhost:8080
KAFKA_UI_PORT=8080

# Cách gửi: broker = kết nối thẳng Kafka (Hydra); http = qua API publish-message (Kafka dev)
KAFKA_MODE=http

KAFKA_TOPIC_INPUT=hydra-profile-scheduler-chotot
# 4 topic output: thông tin bài đăng, ảnh bài đăng, thông tin người đăng, ảnh người đăng
KAFKA_TOPIC_POST=hydra-chotot-post_lss-h
KAFKA_TOPIC_POST_IMAGES=hydra-images-incoming
KAFKA_TOPIC_PROFILE_BIO=hydra-profile-bio-chotot_lss-h
KAFKA_TOPIC_PROFILE_AVATAR=hydra-images-incoming-avatar
KAFKA_TOPIC_LOG=hydra-spider-log
# Gửi log [HYDRA-MONITOR] lên KAFKA_TOPIC_LOG (test trên Kafka dev nên đặt false)
KAFKA_LOGGING_ENABLED=false

# ----- Chỉ dùng khi KAFKA_MODE=http -----
KAFKA_HTTP_URL=
KAFKA_HTTP_API_KEY=
# Số message gom vào 1 request
KAFKA_HTTP_BATCH_SIZE=10
# Giây chờ API phản hồi
KAFKA_HTTP_TIMEOUT=30
KAFKA_HTTP_VERIFY_SSL=false

# ----- Chỉ dùng khi KAFKA_MODE=broker -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Hydra dùng SSL (đặt 3 file chứng chỉ trong chotot/ssl/); không SSL thì đặt PLAINTEXT
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_CAFILE=chotot/ssl/ca.pem
KAFKA_SSL_KEYFILE=chotot/ssl/key.pem
KAFKA_SSL_CERTFILE=chotot/ssl/certificate.pem
KAFKA_SSL_CHECK_HOSTNAME=false
# Spider mẫu dùng 1.0.0; để trống thì tự dò
KAFKA_API_VERSION=
# Đọc topic input
KAFKA_GROUP_ID=group-chotot
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_MS=50000
KAFKA_POLL_MAX_RECORDS=500

# ===================== Redis (chống trùng) =====================
# Dấu vân tay chống trùng hết hạn sau N ngày (quá hạn thì gửi lại 1 lần để đồng bộ), 0 = không hết hạn
DEDUP_TTL_DAYS=30
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===================== Elasticsearch / API profile (để trống thì bỏ qua) =====================
ES_HOST=
ES_INDEX_CRAWLED_TIME=hydra-profiles
END_POINT_API=
API_KEY_GLOBAL=
HYDRA_CRAWLER_SYSTEM=api-crawler

# ===================== API lấy số điện thoại đầy đủ =====================
# false = không gọi API, seller.phone = null. Đi qua proxy giống crawl web (USE_PROXY / CRAWL_PROXY)
PHONE_API_ENABLED=true
PHONE_API_URL=https://gateway.chotot.com/v1/private/ad-listing/phone
# API lấy Bearer token cho API phone (GET, gửi header X-Session-Keeper-Key), đi qua proxy giống crawl.
# Lúc khởi động không lấy được token thì spider dừng và báo lỗi
PHONE_TOKEN_API_URL=https://2ec3-188-116-21-155.ngrok-free.app/token?site=www.chotot.com
# Giá trị header X-Session-Keeper-Key (KHÔNG commit)
PHONE_TOKEN_API_KEY=scrapy_chotot
# Token hết hạn (quá exp hoặc API phone trả 401/403): tạm dừng spider, đợi PHONE_TOKEN_RETRY_DELAY giây
# rồi lấy token mới, thử tối đa PHONE_TOKEN_MAX_RETRIES lần; vẫn không được thì dừng spider
PHONE_TOKEN_RETRY_DELAY=60
PHONE_TOKEN_MAX_RETRIES=3
# Giây chờ API phản hồi
PHONE_API_TIMEOUT=15
# Tốc độ gọi API (tách riêng với crawl web): giây nghỉ giữa 2 lần gọi, số request song song.
# AutoThrottle có thể tự tăng delay khi API phản hồi chậm
PHONE_API_DELAY=1.5
PHONE_API_CONCURRENCY=2
# Lưu số đã lấy trong Redis bao nhiêu giờ để không gọi API lại, 0 = không cache
PHONE_CACHE_TTL_HOURS=168

# ===================== Trang người bán (chotot.com/user/<account_oid>) =====================
# Lấy cho seller: name, avatar (ưu tiên trang người bán), banner, address, joined_at, profile_updated_at,
# is_active, phone_verified, email_verified.
# false = không tải trang người bán, các field này = null
SELLER_PROFILE_ENABLED=true
# Lưu thông tin người bán trong Redis bao nhiêu giờ để không tải lại, 0 = không cache
SELLER_PROFILE_CACHE_TTL_HOURS=72

# ===================== API số liệu người bán (gateway.chotot.com/v1/public) =====================
# 6 API theo account_oid: followers, followings, sold_ads (đã bán), live_ads (đang đăng), rating, total_rating,
# total_rating_as_seller/buyer, response_rate (tỷ lệ phản hồi chat %), response_rate_text, response_time, response_time_text.
# false = không gọi; followers/followings = null, sold_ads/live_ads/rating/total_rating lấy từ trang tin
SELLER_STATS_ENABLED=true
# Lưu số liệu trong Redis bao nhiêu giờ, 0 = không cache
SELLER_STATS_CACHE_TTL_HOURS=24
# Tốc độ riêng (tách khỏi API phone): giây nghỉ giữa 2 request, số request song song
SELLER_STATS_DELAY=0.5
SELLER_STATS_CONCURRENCY=2

# ===================== Crawl =====================
USE_PROXY=true
CRAWL_PROXY=http://172.20.148.40:3129
CHOTOT_START_URL=https://www.chotot.com/mua-ban
# Số trang danh sách tối đa
CHOTOT_MAX_PAGES=1000
# Số tin tối đa mỗi trang, 0 = lấy hết
CHOTOT_MAX_ITEMS_PER_PAGE=0
# Bật/tắt crawl từng site: false = gặp tin của site đó thì bỏ qua, không tải
# (vd vieclamtot đang bị Cloudflare chặn: CRAWL_VIECLAMTOT=false)
CRAWL_CHOTOT=true
CRAWL_XE=true
CRAWL_VIECLAMTOT=false
CRAWL_NHATOT=false
# Dừng sau N tin hợp lệ, 0 = không giới hạn
TARGET_ITEM_COUNT=0
# Tốc độ crawl: giây nghỉ giữa 2 request, số request song song (tổng / mỗi domain)
DOWNLOAD_DELAY=1.5
CONCURRENT_REQUESTS=8
CONCURRENT_REQUESTS_PER_DOMAIN=4

# ===================== Log =====================
LOG_LEVEL=INFO
# Ghi log ra logs/ và bảng tổng kết cuối lượt chạy
MONITOR_ENABLED=true
# In tiến độ sau mỗi N tin
MONITOR_PROGRESS_EVERY=50
